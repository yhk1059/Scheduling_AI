{
  "name": "nurse-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,api \"npm run next-dev\" \"npm run fastapi-dev\"",
    "next-dev": "next dev",
    "fastapi-dev": "uv run uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "uv run pytest backend/tests scripts/test_hooks.py && vitest run",
    "test:e2e": "playwright test",
    "gen:types": "uv run python -m backend.gen_types",
    "gen:demo": "uv run python -m backend.gen_demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
